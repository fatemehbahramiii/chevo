# Copy this file to .env and set real values. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DATABASE_URL=
CONTACT_RECIPIENT_EMAIL=info@chevo.ir
DEFAULT_FROM_EMAIL=webmaster@localhost
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Payment provider credentials must be supplied from the provider dashboard.
BITPAY_API_KEY=
BITPAY_CREATE_PAYMENT_URL=
BITPAY_CALLBACK_URL=http://127.0.0.1:8000/payments/callback/
BITPAY_REDIRECT_BASE_URL=
